{
  "name": "@intelligence/collector-browser-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Long-lived local owner of Collector Chromium profiles and managed page leases.",
  "exports": {
    ".": "./dist/main.js",
    "./client": "./dist/client.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "verify:lifecycle": "node scripts/verify-real-browser-lifecycle.mjs",
    "verify:extension-runtime-rejection": "node scripts/verify-real-extension-runtime-rejection.mjs",
    "verify:multi-profile-isolation": "node scripts/verify-real-multi-profile-isolation.mjs",
    "verify:strategy-binding": "node scripts/verify-real-strategy-binding.mjs",
    "validation-browser": "node scripts/validation-browser.mjs",
    "start:validation-browser": "node scripts/validation-browser.mjs start",
    "rebuild:validation-browser": "node scripts/validation-browser.mjs rebuild",
    "status:validation-browser": "node scripts/validation-browser.mjs status",
    "stop:validation-browser": "node scripts/validation-browser.mjs stop",
    "start:xiaohongshu-validation-browser": "node scripts/xiaohongshu-validation-browser.mjs start",
    "rebuild:xiaohongshu-validation-browser": "node scripts/xiaohongshu-validation-browser.mjs rebuild",
    "status:xiaohongshu-validation-browser": "node scripts/xiaohongshu-validation-browser.mjs status",
    "stop:xiaohongshu-validation-browser": "node scripts/xiaohongshu-validation-browser.mjs stop",
    "validate:xiaohongshu-trusted-search": "node scripts/validate-xiaohongshu-trusted-search.mjs",
    "validate:xiaohongshu-extension-trusted-input": "node scripts/validate-xiaohongshu-extension-trusted-input.mjs",
    "validate:xiaohongshu-gateway-e2e": "node scripts/validate-xiaohongshu-gateway-e2e.mjs",
    "validate:xiaohongshu-gateway-replies-e2e": "node scripts/validate-xiaohongshu-gateway-e2e.mjs --replies",
    "validate:xiaohongshu-gateway-account-notes-e2e": "node scripts/validate-xiaohongshu-gateway-e2e.mjs --account-notes",
    "validate:xiaohongshu-gateway-note-detail-e2e": "node scripts/validate-xiaohongshu-gateway-e2e.mjs --note-detail",
    "recon:xiaohongshu-note-comments": "node scripts/validate-xiaohongshu-gateway-e2e.mjs --comment-recon",
    "recon:xiaohongshu-comment-replies": "node scripts/recon-xiaohongshu-comment-replies.mjs",
    "recon:xiaohongshu-public-profile-entry": "node scripts/recon-xiaohongshu-public-profile-entry.mjs",
    "recon:xiaohongshu-note-overlay": "node scripts/recon-xiaohongshu-note-overlay.mjs",
    "validate:extension-control": "node scripts/validate-extension-control.mjs",
    "canary:discussion-user-selected": "node scripts/validate-bilibili-discussion-e2e.mjs"
  },
  "dependencies": {
    "@intelligence/collector-contracts": "0.1.0",
    "playwright": "^1.61.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22"
  }
}
