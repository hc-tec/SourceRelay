# The model credential is consumed by the selected DeepResearch runtime only.
# The adapter never forwards it to Intelligence Gateway or to a source site.
DEEPSEEK_API_KEY=
DEEPRESEARCH_MODEL=deepseek-chat
DEEPRESEARCH_LLM_BASE_URL=https://api.deepseek.com

# The only network endpoint used by the research tools.
INTELLIGENCE_GATEWAY_URL=http://127.0.0.1:8765
GATEWAY_REQUEST_TIMEOUT=180

# Optional local root for raw artifacts returned by the Gateway.
# Relative paths are resolved from this adapter directory.
GATEWAY_ARTIFACT_ROOT=../intelligence-gateway/runtime

# Do not configure Tavily, Serper, Brave, Bing, Jina or another direct search
# provider here. A framework's built-in search tools must remain disabled.
