{
  "mcpServers": {
    "intelligence_gateway": {
      "enabled": true,
      "type": "stdio",
      "command": "python",
      "args": ["-m", "deepresearch_gateway.mcp_server"],
      "tool_call_timeout": 240,
      "routing": {
        "mode": "prefer",
        "priority": 100,
        "keywords": [
          "中文平台",
          "公众号",
          "小红书",
          "知乎",
          "B站",
          "微博",
          "热榜",
          "个人情报"
        ]
      }
    }
  }
}
