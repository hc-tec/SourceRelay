{
  "name": "@intelligence/collector-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Manifest V3 in-browser collection bridge with deterministic Playwright extension tests.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:test": "node scripts/build.mjs --test",
    "setup:browsers": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:release-manifest": "node scripts/assert-release-manifest.mjs",
    "test:e2e": "node tests/e2e/extension.e2e.mjs",
    "test": "npm run typecheck && npm run build && npm run test:release-manifest && npm run build:test && npm run test:unit && npm run test:e2e",
    "test:all": "npm run setup:browsers && npm test"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.330",
    "esbuild": "^0.25.0",
    "playwright": "^1.61.1",
    "typescript": "^5.8.0"
  }
}
