{
  "name": "@intelligence/collector-extension",
  "version": "0.7.10",
  "private": true,
  "type": "module",
  "description": "Manifest V3 core for user-approved, read-only browser collection tasks.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "setup:build-browser": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "verify:research-projectors": "node scripts/verify-transcript-capture.mjs",
    "verify:artifacts": "node scripts/verify-build-artifacts.mjs",
    "verify:extension-load": "node scripts/verify-extension-load.mjs",
    "verify:build": "npm run typecheck && npm run build && npm run verify:artifacts && npm run verify:extension-load"
  },
  "dependencies": {
    "@intelligence/collector-contracts": "0.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.330",
    "esbuild": "^0.25.0",
    "playwright": "^1.61.1",
    "typescript": "^5.8.0"
  }
}
