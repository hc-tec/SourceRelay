{
  "manifest_version": 3,
  "name": "Personal Intelligence Collector",
  "version": "0.1.0",
  "description": "Runs explicitly approved, read-only collection tasks in the user's browser context.",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Collect visible results"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://search.bilibili.com/*",
    "https://www.bilibili.com/*",
    "https://www.zhihu.com/*",
    "https://zhuanlan.zhihu.com/*",
    "https://s.weibo.com/*",
    "https://weibo.com/*",
    "https://m.weibo.cn/*",
    "https://www.xiaohongshu.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://search.bilibili.com/all*",
        "https://www.zhihu.com/search*",
        "https://s.weibo.com/weibo*",
        "https://www.xiaohongshu.com/search_result_ai*"
      ],
      "js": ["network-capture-bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://search.bilibili.com/*",
        "https://www.bilibili.com/*",
        "https://www.zhihu.com/*",
        "https://zhuanlan.zhihu.com/*",
        "https://s.weibo.com/*",
        "https://weibo.com/*",
        "https://m.weibo.cn/*",
        "https://www.xiaohongshu.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "collect-visible-results": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      },
      "description": "Collect visible result cards from the active supported page"
    }
  }
}
