{
  "manifest_version": 3,
  "name": "Personal Intelligence Collector",
  "version": "0.7.10",
  "description": "Runs explicitly approved, read-only collection tasks in the user's browser context.",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Collector control",
    "default_popup": "control.html"
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://space.bilibili.com/*",
    "https://api.bilibili.com/*",
    "https://www.bilibili.com/*"
  ],
  "optional_host_permissions": [
    "https://search.bilibili.com/*",
    "https://www.zhihu.com/*",
    "https://zhuanlan.zhihu.com/*",
    "https://s.weibo.com/*",
    "https://weibo.com/*",
    "https://m.weibo.cn/*",
    "https://www.xiaohongshu.com/*"
  ]
}
